# Copy to .env and fill in. Never commit real secrets.

ENV=development                # development | test | production
LOG_LEVEL=INFO

# Local dev (docker compose maps Postgres/Redis to these host ports, below the Windows
# dynamic range 49152-65535 where Hyper-V reserves ports at boot, to avoid clashing
# with natively-installed services). Inside compose, services use postgres:5432 / redis:6379.
DATABASE_URL=postgresql+asyncpg://multigent:multigent@localhost:15432/multigent
REDIS_URL=redis://localhost:16379/0
POSTGRES_HOST_PORT=15432
REDIS_HOST_PORT=16379

# KeyVault master keys (AES-256-GCM). JSON object of {key_id: base64(32 random bytes)}.
# Left commented, docker-compose uses a PUBLIC dev-only key (fine locally; the API
# refuses it when ENV=production). For anything real, generate one and uncomment:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# KEY_ENCRYPTION_KEYS={"k1":"<base64 of 32 random bytes>"}
# KEY_ENCRYPTION_ACTIVE_ID=k1

# Session cookie signing secret (>= 32 chars in production). Compose has a dev default.
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
# SESSION_SECRET=

ALLOWED_ORIGINS=http://localhost:3000
COOKIE_DOMAIN=                  # e.g. .example.com in production; empty for localhost

DEBOUNCE_MS=800
WORKER_MAX_CONCURRENT_TURNS=20
SHUTDOWN_GRACE_S=30

# Passwordless login for local dev/tests only. The app refuses to start with this on in production.
DEV_LOGIN=1

# OAuth sign-in (optional). A provider's button appears once both values are set.
# Redirect URIs to register: {PUBLIC_API_URL}/auth/google/callback and /auth/github/callback
PUBLIC_API_URL=http://localhost:8000
WEB_URL=http://localhost:3000
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# Per user per chat (token bucket)
MESSAGE_RATE_PER_MIN=6

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
